# TextLens AI environment example
# Copy to `.env` and update values for your environment.

# =========================
# App / Runtime
# =========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=50

# Optional runtime directory overrides
# UPLOAD_DIR=./uploads
# OUTPUT_DIR=./output
# DATA_RAW_DIR=./data/raw
# DATA_CLEANED_DIR=./data/cleaned
# DATA_CHUNKS_DIR=./data/chunks
# DATA_EMBEDDINGS_DIR=./data/embeddings
# DATA_TEMP_DIR=./data/temp
# LOGS_DIR=./logs

# =========================
# Pinecone / Vector DB
# =========================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=textlens-ai
PINECONE_REGION=
PINECONE_CLOUD=aws
PINECONE_UPSERT_BATCH_SIZE=250
PINECONE_MIN_UPSERT_BATCH_SIZE=50
PINECONE_UPSERT_TIMEOUT_SECONDS=120
PINECONE_UPSERT_MAX_RETRIES=5

# =========================
# Embeddings
# =========================
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=128
EMBEDDING_DEVICE=auto
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_EXECUTION_MODE=local
EMBEDDING_WORKER_TOKEN=
RAG_MIN_RELEVANCE_SCORE=0

# Chunking / ingestion controls
CHUNK_SIZE_SENTENCES=8
CHUNK_OVERLAP_SENTENCES=1
MIN_CHUNK_WORDS=5
MAX_CHUNK_WORDS=180
CSV_READ_CHUNK_SIZE=5000
EMBEDDING_CHECKPOINT_EVERY_BATCHES=10
EMBEDDING_WORKERS=1
EMBEDDING_SAVE_VECTORS=false

# =========================
# LLM QA
# =========================
LLM_PROVIDER=gemini
LLM_ENABLED=true
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=5

# =========================
# Adaptive Top-K + Self-RAG
# =========================
ADAPTIVE_TOP_K_ENABLED=true
ADAPTIVE_TOP_K_MIN=3
ADAPTIVE_TOP_K_MAX=10
SELF_RAG_ENABLED=true
SELF_RAG_CONFIDENCE_THRESHOLD=0.65
SELF_RAG_MAX_RETRIES=1

# =========================
# HyDE + Semantic Cache
# =========================
HYDE_ENABLED=true
HYDE_MAX_QUERY_TOKENS=8
HYDE_PROMPT_MAX_CHARS=500
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_MAX_ENTRIES=512
SEMANTIC_CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
